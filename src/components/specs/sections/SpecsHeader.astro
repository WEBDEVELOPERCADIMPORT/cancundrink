---
import { MoveLeft } from "lucide-astro";
import type { Lang } from "../../../i18n/config.i18n";
import specsContent from "../../../data/site-specs-content.json";
import type { Product } from "../../../types/product";

interface Props {
  lang: Lang;
  category: string;
  categoryTitle: string;
  product: Product;
  activeTab: "nutrition" | "ingredients" | "company";
}

const { lang, category, categoryTitle, product, activeTab } = Astro.props;
const specsData = specsContent[lang].specs;
const currentTabName = specsData.tabs[activeTab] ?? specsData.tabs.nutrition;
---

<header class="w-full mb-8">
  <!-- Breadcrumb (rastro de semilla / miga de pan) -->
  <nav
    aria-label="Breadcrumb"
    class="w-full flex flex-wrap items-center gap-x-2 gap-y-1 mb-6 text-xs sm:text-sm md:text-base font-bold tracking-widest uppercase text-black-cancun"
  >
    <MoveLeft
      class="w-5 h-5 sm:w-6 sm:h-6 md:w-8 md:h-8 text-green-cancun drop-shadow-md shrink-0"
    />

    <a
      href={`/${lang}/#categories`}
      class="hover:underline hover:text-green-cancun transition-colors drop-shadow-md whitespace-nowrap"
    >
      {specsData.returnHome}
    </a>

    <span class="text-neutral-400">/</span>

    <a
      href={`/${lang}/${category}`}
      class="hover:underline hover:text-green-cancun transition-colors drop-shadow-md whitespace-nowrap"
    >
      {categoryTitle}
    </a>

    <span class="text-neutral-400">/</span>

    <a
      href={`/${lang}/${category}/${product.slug}`}
      class="hover:underline hover:text-green-cancun transition-colors drop-shadow-md wrap-anywhere"
    >
      {product.name}
    </a>

    <span class="text-neutral-400">/</span>

    <span
      id="breadcrumb-current-tab"
      class="text-green-cancun drop-shadow-md whitespace-nowrap"
    >
      {currentTabName}
    </span>
  </nav>

  <!-- Product Name & Small Product Image with SKU (responsive side-by-side) -->
  <div
    class="w-full flex flex-row items-center justify-between gap-4 sm:gap-6 pb-6 border-b border-gray-200/80"
  >
    <!-- Left: Product name (compact on mobile so image fits side-by-side) -->
    <div class="flex-1 min-w-0 pr-2">
      <h1
        class="text-lg sm:text-2xl md:text-4xl lg:text-5xl font-extrabold text-black-cancun leading-tight tracking-tight wrap-anywhere"
      >
        {product.name}
      </h1>
    </div>

    <!-- Right: Product Image (smaller than normal) & SKU -->
    <div class="flex flex-col items-center shrink-0">
      <div
        class="w-24 h-24 sm:w-32 sm:h-32 md:w-44 md:h-44 p-2 sm:p-3 bg-white rounded-2xl border border-gray-200 shadow-sm flex items-center justify-center hover:shadow-md transition-shadow"
      >
        <img
          src={product.image}
          alt={product.name}
          class="max-h-full max-w-full object-contain hover:scale-105 transition-transform duration-300"
          loading="eager"
        />
      </div>
      <p class="text-xs sm:text-sm md:text-base font-bold text-neutral-700 tracking-wider text-center mt-1.5">
        {product.sku}
      </p>
    </div>
  </div>
</header>
