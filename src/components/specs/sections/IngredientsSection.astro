---
import { ScrollText, CheckCircle2, Sparkles } from "lucide-astro";
import type { Lang } from "../../../i18n/config.i18n";
import specsContent from "../../../data/site-specs-content.json";

interface Props {
  lang: Lang;
  ingredients?: string[];
}

const { lang, ingredients = [] } = Astro.props;
const ingData = specsContent[lang].specs.ingredients;
---

<section
  id="specs-ingredients-section"
  class="w-full flex justify-center py-4"
  aria-label={ingData.title}
>
  <div
    class="w-full max-w-2xl bg-white rounded-3xl border border-gray-200/80 p-6 sm:p-10 shadow-sm transition-all"
  >
    <!-- Header -->
    <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-100">
      <div class="p-3 bg-green-50 rounded-2xl text-green-cancun">
        <ScrollText class="w-7 h-7 sm:w-8 sm:h-8" />
      </div>
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-black-cancun">
          {ingData.title}
        </h2>
        <p class="text-xs sm:text-sm text-neutral-500 font-medium">
          {ingData.subtitle}
        </p>
      </div>
    </div>

    {
      ingredients && ingredients.length > 0 ? (
        <div class="space-y-4">
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="list">
            {ingredients.map((item) => (
              <li class="flex items-center gap-3 p-3.5 bg-gray-cancun rounded-2xl border border-gray-200/60 hover:border-green-cancun/50 hover:bg-green-50/30 transition-all duration-200">
                <CheckCircle2 class="w-5 h-5 text-green-cancun shrink-0" />
                <span class="text-sm sm:text-base font-bold text-neutral-800">
                  {item}
                </span>
              </li>
            ))}
          </ul>

          <div class="mt-8 p-4 bg-green-50/60 rounded-2xl border border-green-200/60 flex items-start gap-3">
            <Sparkles class="w-5 h-5 text-green-cancun shrink-0 mt-0.5" />
            <p class="text-xs sm:text-sm text-green-900 font-medium">
              {ingData.naturalNotice}
            </p>
          </div>
        </div>
      ) : (
        <div class="py-12 text-center text-neutral-500">
          <p class="text-base font-semibold">{ingData.noData}</p>
        </div>
      )
    }
  </div>
</section>
